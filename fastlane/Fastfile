# Release automation. Run from the repo root with `bundle exec fastlane <lane>`.
#
#   bundle exec fastlane bump version:3.2.5 [platform:android|ios]   # versionName / MARKETING_VERSION
#   bundle exec fastlane android internal [notes_file:PATH]          # Play internal testing track
#   bundle exec fastlane ios beta [notes_file:PATH]                  # TestFlight
#   bundle exec fastlane android status / ios status                 # versions in the repo and the store → fastlane/output
#   bundle exec fastlane android qa build_type:debug|release         # QA: APK → Firebase App Distribution
#   bundle exec fastlane ios qa build_type:debug|release             # QA: Debug or Release archive → TestFlight
#
# `dry_run:true` builds and validates without publishing, then restores the version files.
# `notes_file` is a UTF-8 text file with the release notes (Play "What's new" / TestFlight "What to Test").
# Production release and App Review submission stay manual in the consoles.

require "json"
require "tmpdir"
require "tempfile"

ROOT = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
SECRETS_DIR = File.expand_path(ENV.fetch("CCH_SECRETS_DIR", "~/.config/chukchukhaksa"))
GRADLE_FILE = File.join(ROOT, "androidApp/build.gradle.kts")
PBXPROJ = File.join(ROOT, "iosApp/iosApp.xcodeproj/project.pbxproj")
AAB_PATH = File.join(ROOT, "androidApp/build/outputs/bundle/release/androidApp-release.aab")
IOS_OUTPUT_DIR = File.join(ROOT, "build/fastlane/ios")
# Status JSON, notes and logs for the /release skill. Kept outside build/ so tools that skip build
# outputs can still read them; git-ignored.
OUTPUT_DIR = File.join(ROOT, "fastlane/output")
# The Play listing has a single language.
PLAY_LANGUAGE = "ko-KR"
PLAY_TRACKS = %w[production beta alpha internal].freeze
# Play counts characters; TestFlight counts UTF-8 bytes (a Korean character is 3 bytes).
PLAY_NOTES_LIMIT = 500
TESTFLIGHT_NOTES_BYTE_LIMIT = 4000
FIREBASE_NOTES_LIMIT = 16_000
ANDROID_PACKAGE = "com.kunize.uswtimetable"
GOOGLE_SERVICES_JSON = File.join(ROOT, "androidApp/google-services.json")
# QA builds go to this Firebase App Distribution group (alias).
FIREBASE_QA_GROUP = "척척학사"

# The app and widget targets each have Debug and Release configs.
PBX_VERSION_COUNT = 4

# Replaces every match of `pattern` (group 1 = prefix kept as is) and checks how many there were,
# so a changed file layout fails loudly instead of silently bumping only some of the values.
def replace_exactly(path, pattern, expected_count, value)
  content = File.read(path)
  count = content.scan(pattern).length
  UI.user_error!("Expected #{expected_count} match(es) of #{pattern.inspect} in #{path}, found #{count}") if count != expected_count
  File.write(path, content.gsub(pattern) { "#{Regexp.last_match(1)}#{value}" })
end

def read_single(path, pattern, expected_count)
  matches = File.read(path).scan(pattern).map(&:last)
  values = matches.uniq
  if matches.length != expected_count || values.length != 1
    UI.user_error!("Expected #{expected_count} identical match(es) of #{pattern.inspect} in #{path}, found #{matches.inspect}")
  end
  values.first
end

GRADLE_VERSION_CODE = /^(\s*versionCode = )(\d+)$/
GRADLE_VERSION_NAME = /^(\s*versionName = )"([^"]+)"$/
PBX_BUILD = /(CURRENT_PROJECT_VERSION = )(\d+)(?=;)/
PBX_MARKETING = /(MARKETING_VERSION = )([\d.]+)(?=;)/

# Restores the given files after the block when `dry_run` is set, so a dry run leaves no diff.
def with_restore(paths, dry_run)
  originals = paths.to_h { |p| [p, File.read(p)] }
  begin
    yield
  ensure
    if dry_run
      originals.each { |p, c| File.write(p, c) }
      UI.message("dry_run: restored #{paths.map { |p| File.basename(p) }.join(', ')}")
    end
  end
end

def dry_run?(options)
  options[:dry_run].to_s == "true"
end

# Reads `notes_file:` (nil when not given) and enforces the store's length limit
# (characters, or UTF-8 bytes with `bytes: true`).
def release_notes(options, limit, bytes: false)
  path = options[:notes_file].to_s
  return nil if path.empty?
  path = File.expand_path(path, ROOT)
  UI.user_error!("notes_file not found: #{path}") unless File.exist?(path)
  notes = File.read(path, encoding: "UTF-8").delete_prefix("﻿").strip
  UI.user_error!("notes_file is empty: #{path}") if notes.empty?
  size = bytes ? notes.bytesize : notes.length
  unit = bytes ? "bytes" : "characters"
  UI.user_error!("Release notes are #{size} #{unit}; the limit here is #{limit}") if size > limit
  notes
end

# `build_type:` for the QA lanes: debug (default) or release.
def qa_build_type(options)
  build_type = (options[:build_type] || "debug").to_s.downcase
  UI.user_error!("build_type must be debug or release") unless %w[debug release].include?(build_type)
  build_type
end

def last_tag(suffix)
  tags = sh("git", "-C", ROOT, "tag", "--list", "v*#{suffix}", "--sort=-v:refname", log: false).split("\n")
  tags.first
end

def write_status(name, data)
  FileUtils.mkdir_p(OUTPUT_DIR)
  path = File.join(OUTPUT_DIR, "status-#{name}.json")
  File.write(path, JSON.pretty_generate(data))
  UI.success("Wrote #{path}")
  puts JSON.pretty_generate(data)
end

def git_status_warning(*paths)
  dirty = sh("git", "-C", ROOT, "status", "--porcelain", "--", *paths, log: false).strip
  UI.important("Version files already have uncommitted changes:\n#{dirty}") unless dirty.empty?
end

desc "Set the marketing version (versionName / MARKETING_VERSION); platform:android|ios limits it to one"
lane :bump do |options|
  version = options[:version].to_s
  UI.user_error!("Pass version:X.Y.Z") unless version.match?(/\A\d+\.\d+\.\d+\z/)
  target = options[:platform].to_s
  UI.user_error!("platform must be android, ios, or omitted for both") unless ["", "android", "ios"].include?(target)
  replace_exactly(GRADLE_FILE, GRADLE_VERSION_NAME, 1, "\"#{version}\"") unless target == "ios"
  replace_exactly(PBXPROJ, PBX_MARKETING, PBX_VERSION_COUNT, version) unless target == "android"
  UI.success("Marketing version set to #{version} (#{target.empty? ? 'android + ios' : target}).")
end

platform :android do
  def play_max_version_code
    tracks = PLAY_TRACKS
    failed = []
    codes = tracks.flat_map do |track|
      google_play_track_version_codes(track: track)
    rescue StandardError => e
      UI.important("Could not read Play track '#{track}': #{e.message}")
      failed << track
      []
    end
    # Every track failing means credentials or the API are broken, not that the tracks are empty;
    # falling back to the local versionCode would build and upload a code Play already has.
    UI.user_error!("Could not read any Play track; check #{SECRETS_DIR}/play-service-account.json") if failed.length == tracks.length
    codes.max || 0
  end

  def ensure_release_signing
    props = File.exist?(File.join(ROOT, "local.properties")) ? File.read(File.join(ROOT, "local.properties")) : ""
    missing = %w[RELEASE_STORE_FILE RELEASE_STORE_PASSWORD RELEASE_KEY_ALIAS RELEASE_KEY_PASSWORD]
      .reject { |key| props.match?(/^\s*#{key}\s*[=:]\s*\S/) }
    UI.user_error!("local.properties is missing upload-key signing values: #{missing.join(', ')}") unless missing.empty?
  end

  desc "Write the repo and Play Console versions to fastlane/output/status-android.json"
  lane :status do
    tracks = PLAY_TRACKS.to_h do |track|
      info = begin
        { "version_codes" => google_play_track_version_codes(track: track),
          "release_names" => google_play_track_release_names(track: track) }
      rescue StandardError => e
        { "error" => e.message }
      end
      [track, info]
    end
    write_status("android", {
      "repo" => { "version_name" => read_single(GRADLE_FILE, GRADLE_VERSION_NAME, 1),
                  "version_code" => read_single(GRADLE_FILE, GRADLE_VERSION_CODE, 1).to_i },
      "play" => tracks,
      "last_tag" => last_tag("-android"),
    })
  end

  desc "Build a signed AAB with the next versionCode and upload it to the internal testing track"
  lane :internal do |options|
    dry_run = dry_run?(options)
    notes = release_notes(options, PLAY_NOTES_LIMIT)
    ensure_release_signing
    git_status_warning(GRADLE_FILE)

    local_code = read_single(GRADLE_FILE, GRADLE_VERSION_CODE, 1).to_i
    # Above the repo too: a QA build commits a versionCode that never reaches Play, and reusing it here
    # would give two different binaries the same code on testers' phones.
    next_code = [play_max_version_code + 1, local_code + 1].max
    version_name = read_single(GRADLE_FILE, GRADLE_VERSION_NAME, 1)
    UI.message("Android #{version_name}: versionCode #{local_code} -> #{next_code}")

    with_restore([GRADLE_FILE], dry_run) do
      replace_exactly(GRADLE_FILE, GRADLE_VERSION_CODE, 1, next_code)
      gradle(task: ":androidApp:bundleRelease", project_dir: ROOT)
      # supply reads release notes only from a metadata folder (<lang>/changelogs/<versionCode>.txt),
      # so the notes go into a throwaway one; the store listing itself is never uploaded.
      Dir.mktmpdir("play-notes") do |metadata_dir|
        if notes
          changelogs = File.join(metadata_dir, PLAY_LANGUAGE, "changelogs")
          FileUtils.mkdir_p(changelogs)
          File.write(File.join(changelogs, "#{next_code}.txt"), notes)
        end
        upload_to_play_store(
          track: "internal",
          release_status: "completed",
          aab: AAB_PATH,
          metadata_path: metadata_dir,
          skip_upload_apk: true,
          skip_upload_metadata: true,
          skip_upload_changelogs: notes.nil?,
          skip_upload_images: true,
          skip_upload_screenshots: true,
          validate_only: dry_run,
        )
      end
    end
    UI.success(dry_run ? "dry_run: Play accepted versionCode #{next_code} (nothing published)" :
                         "Uploaded #{version_name} (#{next_code}) to the internal track. Commit the versionCode change.")
  end

  # Firebase project and Android app ID, read from google-services.json (git-ignored, like the other config).
  def firebase_android_app
    UI.user_error!("Missing #{GOOGLE_SERVICES_JSON}") unless File.exist?(GOOGLE_SERVICES_JSON)
    json = JSON.parse(File.read(GOOGLE_SERVICES_JSON))
    client = json.fetch("client").find do |c|
      c.dig("client_info", "android_client_info", "package_name") == ANDROID_PACKAGE
    end
    UI.user_error!("google-services.json has no client for #{ANDROID_PACKAGE}") unless client
    { project: json.dig("project_info", "project_id"), app_id: client.dig("client_info", "mobilesdk_app_id") }
  end

  desc "QA: build a debug or release APK with the next versionCode and send it to the Firebase QA group"
  lane :qa do |options|
    dry_run = dry_run?(options)
    build_type = qa_build_type(options)
    notes = release_notes(options, FIREBASE_NOTES_LIMIT)
    # Release builds are signed with the upload key; debug builds use the local debug keystore.
    ensure_release_signing if build_type == "release"
    firebase = firebase_android_app
    git_status_warning(GRADLE_FILE)

    local_code = read_single(GRADLE_FILE, GRADLE_VERSION_CODE, 1).to_i
    # Above Play and above the last QA build, so a QA phone can install it over the previous QA build.
    next_code = [play_max_version_code + 1, local_code + 1].max
    version_name = read_single(GRADLE_FILE, GRADLE_VERSION_NAME, 1)
    UI.message("Android QA #{build_type} #{version_name}: versionCode #{local_code} -> #{next_code}")

    with_restore([GRADLE_FILE], dry_run) do
      replace_exactly(GRADLE_FILE, GRADLE_VERSION_CODE, 1, next_code)
      gradle(task: ":androidApp:assemble#{build_type.capitalize}", project_dir: ROOT)
      apk = File.join(ROOT, "androidApp/build/outputs/apk/#{build_type}/androidApp-#{build_type}.apk")
      UI.user_error!("APK not found: #{apk}") unless File.exist?(apk)
      if dry_run
        UI.success("dry_run: built #{apk} (not distributed)")
        next
      end
      Tempfile.create(["qa-notes", ".txt"]) do |notes_file|
        args = ["firebase", "appdistribution:distribute", apk,
                "--project", firebase[:project], "--app", firebase[:app_id], "--groups", FIREBASE_QA_GROUP]
        if notes
          notes_file.write(notes)
          notes_file.flush
          args += ["--release-notes-file", notes_file.path]
        end
        sh(*args)
      end
      UI.success("Distributed #{version_name} (#{next_code}, #{build_type}) to Firebase group #{FIREBASE_QA_GROUP}. " \
                 "Commit the versionCode change.")
    end
  end
end

platform :ios do
  def asc_api_key
    env_file = File.join(SECRETS_DIR, "asc-api-key.env")
    UI.user_error!("Missing #{env_file}") unless File.exist?(env_file)
    env = File.readlines(env_file, chomp: true).reject { |l| l.strip.empty? || l.start_with?("#") }
              .to_h { |l| l.split("=", 2).map { |part| part.strip.delete_prefix('"').delete_suffix('"') } }
    app_store_connect_api_key(
      key_id: env.fetch("ASC_KEY_ID"),
      issuer_id: env.fetch("ASC_ISSUER_ID"),
      # A relative path means a key file next to asc-api-key.env, not one in the repo root.
      key_filepath: File.expand_path(env.fetch("ASC_KEY_PATH"), SECRETS_DIR),
    )
  end

  # The version on sale and its build. Raises when nothing is live or the lookup fails.
  def live_app_store_version(api_key)
    app_store_build_number(api_key: api_key, live: true)
    { "version" => lane_context[SharedValues::LATEST_VERSION].to_s,
      "build" => lane_context[SharedValues::LATEST_BUILD_NUMBER].to_s }
  end

  desc "Write the repo and App Store Connect versions to fastlane/output/status-ios.json"
  lane :status do
    api_key = asc_api_key
    latest_build = latest_testflight_build_number(api_key: api_key, initial_build_number: 0).to_i
    latest_version = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION]
    live = begin
      live_app_store_version(api_key)
    rescue StandardError => e
      { "error" => e.message }
    end
    write_status("ios", {
      "repo" => { "marketing_version" => read_single(PBXPROJ, PBX_MARKETING, PBX_VERSION_COUNT),
                  "build" => read_single(PBXPROJ, PBX_BUILD, PBX_VERSION_COUNT).to_i },
      "asc_latest_upload" => { "version" => latest_version, "build" => latest_build },
      "app_store_live" => live,
      "last_tag" => last_tag("-ios"),
    })
  end

  desc "Archive with the next build number and upload it to TestFlight"
  lane :beta do |options|
    testflight_upload(options, "Release")
  end

  desc "QA: archive the Debug (default) or Release configuration and upload it to TestFlight internal testers"
  lane :qa do |options|
    configuration = qa_build_type(options) == "debug" ? "Debug" : "Release"
    testflight_upload(options, configuration, banner: "[QA #{configuration.upcase} - 심사 제출 금지]")
  end

  # Shared by beta and qa. Internal testers get every processed build without beta review,
  # so uploading is all it takes; external groups are never touched.
  # QA builds share the version's build list with the real ones, so `banner` goes on the first line of
  # "What to Test" to keep them from being picked for App Review.
  def testflight_upload(options, configuration, banner: nil)
    dry_run = dry_run?(options)
    notes = release_notes(options, TESTFLIGHT_NOTES_BYTE_LIMIT, bytes: true)
    if banner
      notes = notes.nil? ? banner : (notes.start_with?(banner) ? notes : "#{banner}\n#{notes}")
      if notes.bytesize > TESTFLIGHT_NOTES_BYTE_LIMIT
        UI.user_error!("Release notes are #{notes.bytesize} bytes with the QA banner; the limit is #{TESTFLIGHT_NOTES_BYTE_LIMIT}")
      end
    end
    git_status_warning(PBXPROJ)
    api_key = asc_api_key

    local_build = read_single(PBXPROJ, PBX_BUILD, PBX_VERSION_COUNT).to_i
    # Latest upload of any version: build numbers on ASC have run ahead of the pbxproj before.
    latest = latest_testflight_build_number(api_key: api_key, initial_build_number: 0).to_i
    next_build = [latest + 1, local_build].max
    version = read_single(PBXPROJ, PBX_MARKETING, PBX_VERSION_COUNT)
    latest_version = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION].to_s
    if latest_version.match?(/\A\d+(\.\d+)*\z/) && Gem::Version.new(version) < Gem::Version.new(latest_version)
      UI.user_error!("Local version #{version} is older than #{latest_version} on App Store Connect. " \
                     "Run `bundle exec fastlane bump version:X.Y.Z platform:ios` first.")
    end
    # A version that is already live has a closed train: App Store Connect rejects new builds for it.
    live_version = begin
      live_app_store_version(api_key)["version"]
    rescue StandardError => e
      UI.important("Could not read the live App Store version: #{e.message}")
      nil
    end
    if live_version == version
      UI.user_error!("#{version} is already live on the App Store, so its train is closed. " \
                     "Run `bundle exec fastlane bump version:X.Y.Z platform:ios` first.")
    end
    UI.message("iOS #{version} #{configuration}: build #{local_build} -> #{next_build} " \
               "(latest on ASC: #{latest_version} (#{latest}))")

    with_restore([PBXPROJ], dry_run) do
      replace_exactly(PBXPROJ, PBX_BUILD, PBX_VERSION_COUNT, next_build)
      # Signing uses the Apple ID signed in to Xcode on this Mac (automatic signing, cloud
      # distribution certificate), the same way a manual archive does.
      ipa = build_app(
        project: File.join(ROOT, "iosApp/iosApp.xcodeproj"),
        scheme: "iosApp",
        configuration: configuration,
        export_method: "app-store",
        export_options: { manageAppVersionAndBuildNumber: false },
        xcargs: "-allowProvisioningUpdates",
        # xcargs only reach the archive step; the export step needs its own flag to fetch the
        # cloud-managed distribution certificate and App Store profiles.
        export_xcargs: "-allowProvisioningUpdates",
        output_directory: IOS_OUTPUT_DIR,
        output_name: "ChukChukHaksa-#{version}-#{next_build}#{configuration == 'Release' ? '' : "-#{configuration}"}",
      )
      if dry_run
        UI.message("dry_run: \"What to Test\" would be:\n#{notes}") if notes
        UI.success("dry_run: built #{ipa} (not uploaded)")
      else
        # With a changelog, pilot waits until the build shows up on ASC to set "What to Test",
        # then returns without waiting for processing to finish.
        begin
          upload_to_testflight(api_key: api_key, ipa: ipa, changelog: notes, skip_waiting_for_build_processing: true)
        rescue StandardError => e
          # A failure after the binary went up (waiting for the build, setting "What to Test") must not
          # read as a failed upload: the build number is taken, so the version file has to be committed.
          raise e unless notes
          uploaded = begin
            latest_testflight_build_number(api_key: api_key, version: version, initial_build_number: 0).to_i >= next_build
          rescue StandardError
            false
          end
          raise e unless uploaded
          UI.important("Build #{next_build} was uploaded, but setting \"What to Test\" failed: #{e.message}. " \
                       "Set it in App Store Connect.")
        end
        UI.success("Uploaded #{version} (#{next_build}) to TestFlight. Commit the build number change.")
      end
    end
  end
end
